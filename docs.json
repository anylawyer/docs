{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AnyLawyer Documentation",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#023220",
    "light": "#023220"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "User Management",
            "pages": ["user/adding"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://anylawyer.com",
          "icon": "book-open-cover"
        },
        {
          "anchor": "AnyLawyer App",
          "href": "https://anylawyer.com/app",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Go to app",
      "href": "https://anylawyer.com/app"
    }
  },
  "contextual": {
    "options": []
  },
  "footer": {
    "socials": {}
  }
}
